# AWS SES Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_SOURCE_EMAIL=your_verified_ses_email@example.com
AWS_TO_EMAIL=your_recipient_email@example.com

# reCAPTCHA Configuration
# Frontend (public - starts with VITE_)
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# Backend (private)
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# Server Configuration
PORT=3001

# UTM Source Mapping (Optional - JSON encoded)
# VITE_UTM_SOURCE_MAP={"custom_source": "Custom Subject"}
